# Invasive Trace — Environment Variables
# Copy to .env and supply real values. NEVER commit .env to version control.

# --- Application ---
PROJECT_NAME="Invasive Trace"
ENVIRONMENT="dev"
PORT=8000

# --- Database (must match compose.yml) ---
POSTGRES_DB=invasive_trace
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
DATABASE_URL="postgresql+asyncpg://appuser:changeme@localhost:5432/invasive_trace"

# --- External APIs ---
# iNaturalist: https://www.inaturalist.org/users/edit  (under "API" section)
INAT_API_KEY=

# EDDMapS: request key from https://www.eddmaps.org/
EDDMAPS_API_KEY=

# Microsoft Planetary Computer (optional — anonymous works for public data)
# Register at https://planetarycomputer.microsoft.com/ for a rate-limit-exempt key
PC_SDK_SUBSCRIPTION_KEY=

# Google Earth Engine / AlphaEarth benchmark (Wave 1.5 only)
# GEE project id with Earth Engine API enabled
GEE_PROJECT=
# Optional bearer token for Earth Engine REST checks
GEE_ACCESS_TOKEN=
# Benchmark-only asset id; do not use in production flow
ALPHAEARTH_COLLECTION=GOOGLE/SATELLITE_EMBEDDING/V1/ANNUAL

# --- Runtime ---
LOG_LEVEL=info
